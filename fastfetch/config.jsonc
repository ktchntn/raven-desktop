{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@HOME@/.config/fastfetch/logo.txt",
    "position": "top",
    "color": {
      "1": "38;2;198;255;0",
      "2": "38;2;51;51;51"
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;163;163;163",
      "title": "38;2;242;242;242",
      "separator": "38;2;122;122;122"
    },
    "key": {
      "width": 11
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "nevermore",
      "outputColor": "3;38;2;122;122;122"
    },
    "break",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": "/"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;122;122;122m● \u001b[38;2;163;163;163m● \u001b[38;2;242;242;242m● \u001b[38;2;242;242;242m● \u001b[38;2;242;242;242m● \u001b[38;2;163;163;163m● \u001b[38;2;122;122;122m● \u001b[38;2;198;255;0m● \u001b[0m"
    }
  ]
}