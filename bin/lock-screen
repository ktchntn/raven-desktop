#!/bin/sh
# Lock the screen (⌘K, hypridle). First choice: the shell's own lock (dot rain, services/Lock.qml).
# If the shell isn't running or the lock isn't confirmed within 2 s, hyprlock as before.
pw-play --volume 0.4 "$HOME/.local/share/raven/sounds/lock.ogg" &
if raven-ipc lock lock >/dev/null 2>&1; then
    i=0
    while [ $i -lt 10 ]; do
        [ "$(raven-ipc lock secure 2>/dev/null)" = true ] && exit 0
        sleep 0.2
        i=$((i + 1))
    done
fi
pidof hyprlock >/dev/null || exec hyprlock
