    "diffEditor.border": "#2A2A2A",
    "gitDecoration.addedResourceForeground": "#C6FF00",
    "gitDecoration.untrackedResourceForeground": "#C6FF00",
    "gitDecoration.modifiedResourceForeground": "#F2F2F2",
    "gitDecoration.deletedResourceForeground": "#7A7A7A",
    "gitDecoration.ignoredResourceForeground": "#5E5E5E",
