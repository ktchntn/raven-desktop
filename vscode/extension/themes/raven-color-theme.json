    "terminal.ansiBrightRed": "#C6FF00",
    "terminal.ansiGreen": "#9E9E9E",
    "terminal.ansiBrightGreen": "#9E9E9E",
    "terminal.ansiYellow": "#FFFFFF",
    "terminal.ansiBrightYellow": "#FFFFFF",
    "terminal.ansiBlue": "#F2F2F2",
    "terminal.ansiBrightBlue": "#F2F2F2",
    "terminal.ansiMagenta": "#B5B5B5",
    "terminal.ansiBrightMagenta": "#B5B5B5",
    "terminal.ansiCyan": "#8A8A8A",
    "terminal.ansiBrightCyan": "#8A8A8A",
